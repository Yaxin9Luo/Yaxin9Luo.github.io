# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Keep the Ruby lockfile so traditional-site builds resolve consistently.

# Ingore files created by npm
node_modules
package-lock.json
!world/package-lock.json

# Ignore local Ruby bundle installs
vendor/
/vendor
__pycache__/
*.blend1

# Generated combined site, game output, and local build/runtime scratch.
/dist/
/world/dist/
/work/
.jekyll-cache/
